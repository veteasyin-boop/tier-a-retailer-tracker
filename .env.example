# Public browser configuration only. Never put the Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_BASE_URL=https://api.your-domain.example

# Development-only compatibility switch. Never set in production.
# Enables the old single-tenant prototype shell; it does not enable tenant data access.
# VITE_ENABLE_LEGACY_PROTOTYPE=true
# LEGACY_MANAGER_PIN=SET_A_UNIQUE_LOCAL_DEV_PIN
